{
  "app": {
    // 签名材料不入库：证书/私钥/口令都是个人或企业资产，仓库里保持为空。
    // 本地构建签名请在 DevEco Studio 中配置：
    //   File → Project Structure → Signing Configs → 勾选 Automatically generate signature
    // 需要用自己的发布证书时，同样在该面板导入 .p12/.p7b/.cer，IDE 会把配置写回本文件
    // （只写本地，不要提交；仓库根目录的 scripts/check_no_secrets.py 会在提交前拦截口令）。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "nativeCompiler": "BiSheng"
        }
      },
      {
        "name": "release",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "nativeCompiler": "BiSheng"
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "release"
          ]
        }
      ]
    }
  ]
}
